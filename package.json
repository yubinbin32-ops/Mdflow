{
  "name": "mdflow",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "mcp": "node packages/mcp/src/server.mjs",
    "test": "npm run plugin:build && node --test packages/mcp/test/*.test.mjs",
    "benchmark:todo": "node scripts/context-parity.mjs --write-report=benchmarks/todo-context-parity.json",
    "release:verify": "npm run plugin:build && npm run desktop:build && sh scripts/package-app.sh debug && node scripts/verify-package.mjs dist/mdflow.app --write-manifest --resign",
    "release:notarize": "sh scripts/notarize-app.sh",
    "plugin:build": "esbuild packages/mcp/src/server.mjs --bundle --platform=node --format=esm --target=node22 --outfile=plugins/mdflow/server/mdflow-mcp.mjs",
    "desktop:build": "swift build --package-path apps/desktop",
    "desktop:run": "swift run --package-path apps/desktop mdflow-desktop",
    "desktop:package": "sh scripts/package-app.sh"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "esbuild": "^0.25.9",
    "js-tiktoken": "^1.0.21"
  }
}
